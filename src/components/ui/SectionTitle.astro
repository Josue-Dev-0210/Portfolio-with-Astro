---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { label, title, subtitle, align = 'center' } = Astro.props;
const alignStyle = align === 'left' ? 'text-align:left;' : 'text-align:center;';
const marginStyle = align === 'left' ? '' : 'margin:0 auto;';
---

<div class="section-title-wrap" style={`${alignStyle}margin-bottom:4rem;`}>
  {label && (
    <div style={`display:inline-flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;${align === 'center' ? 'justify-content:center;' : ''}`}>
      <div style="width:24px;height:1px;background:var(--neon-purple);"></div>
      <span style="font-family:var(--font-mono);font-size:0.72rem;letter-spacing:0.2em;color:var(--neon-purple);text-transform:uppercase;">
        {label}
      </span>
      <div style="width:24px;height:1px;background:var(--neon-purple);"></div>
    </div>
  )}
  <h2 style={`font-family:var(--font-display);font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;color:var(--text-primary);letter-spacing:-0.02em;line-height:1.15;${marginStyle}max-width:700px;`}>
    <span set:html={title} />
  </h2>
  {subtitle && (
    <p style={`margin-top:1rem;color:var(--text-secondary);font-size:1.05rem;max-width:560px;${marginStyle}`}>
      {subtitle}
    </p>
  )}
  <div style={`margin-top:1.5rem;height:2px;width:60px;background:linear-gradient(90deg,var(--deep-purple),var(--neon-purple));border-radius:1px;box-shadow:0 0 8px rgba(168,85,247,0.5);${align === 'center' ? 'margin-left:auto;margin-right:auto;' : ''}`}></div>
</div>
