---
// src/components/ui/NavBar.astro
import Menu from '../icons/Menu.astro';
import Close from '../icons/Close.astro';
import GitHub from '../icons/GitHub.astro';

const navItems = [
  { label: 'Home', href: '#hero' },
  { label: 'About Me', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Experience', href: '#experience' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  id="navbar"
  style="position:fixed;top:0;left:0;right:0;z-index:1000;transition:all 0.3s ease;"
>

  <div style="
    background: rgba(5,5,8,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(168,85,247,0.12);
  ">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;height:72px;">


      <a href="#hero" style="text-decoration:none;display:flex;align-items:center;gap:0.5rem;">
        <div style="
          width:36px;height:36px;
          background:linear-gradient(135deg,#7c3aed,#a855f7);
          border-radius:6px;
          display:flex;align-items:center;justify-content:center;
          box-shadow:0 0 15px rgba(168,85,247,0.5);
          font-family:var(--font-display);font-size:0.85rem;font-weight:900;color:#fff;
        ">JC</div>
        <span style="font-family:var(--font-display);font-size:0.9rem;font-weight:700;color:var(--neon-purple);letter-spacing:0.08em;">
          JOSUÉ <span style="color:var(--text-secondary);">C.</span>
        </span>
      </a>

      <nav style="display:flex;align-items:center;gap:2rem;" class="desktop-nav">
        {navItems.map((item) => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
      </nav>

      <div style="display:flex;align-items:center;gap:1rem;" class="desktop-nav">
        <a href="https://github.com" target="_blank" rel="noopener" style="color:var(--text-secondary);transition:color 0.2s;display:flex;" aria-label="GitHub">
          <GitHub size={20} />
        </a>
        <a href="#contact" class="btn btn-primary" style="padding:0.5rem 1.25rem;font-size:0.72rem;">
          Contact
        </a>
      </div>

      <button
        id="menu-btn"
        class="mobile-menu-btn"
        aria-label="Open menu"
        style="
          background:none;border:1px solid rgba(168,85,247,0.3);
          border-radius:6px;padding:0.4rem;color:var(--neon-purple);
          cursor:pointer;display:none;
        "
      >
        <Menu size={22} />
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="mobile-nav"
    style="
      position:fixed;top:0;right:0;bottom:0;width:280px;
      background:rgba(13,13,26,0.98);
      backdrop-filter:blur(20px);
      border-left:1px solid rgba(168,85,247,0.2);
      padding:2rem 1.5rem;
      display:flex;flex-direction:column;gap:1rem;
      z-index:1001;
    "
  >
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;">
      <span style="font-family:var(--font-display);color:var(--neon-purple);font-size:0.85rem;letter-spacing:0.1em;">NAVIGATION</span>
      <button id="close-btn" style="background:none;border:none;color:var(--text-secondary);cursor:pointer;" aria-label="Close menu">
        <Close size={22} />
      </button>
    </div>
    {navItems.map((item) => (
      <a
        href={item.href}
        class="nav-link"
        style="font-size:1rem;padding:0.75rem 0;border-bottom:1px solid rgba(168,85,247,0.08);"
      >
        {item.label}
      </a>
    ))}
    <a href="#contact" class="btn btn-primary" style="margin-top:1rem;justify-content:center;">
      Contact
    </a>
  </div>
</header>

<style>
  @media (max-width: 768px) {
    .desktop-nav { display: none !important; }
    .mobile-menu-btn { display: flex !important; }
  }
</style>
