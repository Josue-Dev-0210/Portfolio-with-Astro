---
interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<span class="brand-mark" style={`width:${size}px;height:${size}px;`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none">
    <path d="M12 4.5v4M12 15.5v4M4.5 12h4M15.5 12h4M6.7 6.7l3 3m4.6 4.6 3 3m0-10.6-3 3m-4.6 4.6-3 3" />
    <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
    <circle cx="12" cy="4" r="1" fill="currentColor" stroke="none" />
    <circle cx="20" cy="12" r="1" fill="currentColor" stroke="none" />
    <circle cx="12" cy="20" r="1" fill="currentColor" stroke="none" />
    <circle cx="4" cy="12" r="1" fill="currentColor" stroke="none" />
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 9px;
    background: linear-gradient(145deg, var(--deep-purple), var(--neon-purple));
    box-shadow: var(--glow-sm);
    color: #fff;
  }

  svg {
    width: 68%;
    height: 68%;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
