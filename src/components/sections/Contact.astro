---
import SectionTitle from '../ui/SectionTitle.astro';
import GitHub from '../icons/GitHub.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import Twitter from '../icons/Twitter.astro';
import Mail from '../icons/Mail.astro';
import ArrowRight from '../icons/ArrowRight.astro';
---

<section id="contact" class="section" style="background:var(--bg-void);position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:700px;height:700px;background:radial-gradient(ellipse,rgba(124,58,237,0.08) 0%,transparent 70%);pointer-events:none;"></div>

  <div class="container" style="position:relative;z-index:1;">
    <div class="reveal">
      <SectionTitle
        label="Contact"
        title='Let`s <span style="color:var(--neon-purple);">work together</span>'
        subtitle="Available for freelance projects, collaborations, and remote opportunities."
      />
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;max-width:1000px;margin:0 auto;" class="contact-grid">

      <div class="reveal-left">
        <p style="font-family:var(--font-mono);font-size:0.72rem;color:var(--text-muted);margin-bottom:1.5rem;">Communication Channels</p>

        <button
          id="copy-email"
          style="
            display:flex;align-items:center;gap:0.75rem;
            width:100%;
            background:var(--bg-surface);
            border:1px solid rgba(168,85,247,0.2);
            border-radius:8px;padding:1rem 1.25rem;
            cursor:pointer;
            transition:all 0.3s ease;
            margin-bottom:1rem;
            text-align:left;
          "
          class="email-btn"
          aria-label="copy email"
        >
          <Mail size={18} />
          <span style="color:var(--text-primary);font-size:0.9rem;font-family:var(--font-mono);">josue.dev.0210@gmail.com</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-muted);font-family:var(--font-mono);letter-spacing:0.08em;">copy</span>
        </button>

        <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:2.5rem;">
          {[
            { label: 'GitHub', sub: '@josue-dev-0210', href: 'https://github.com', icon: 'github' },
            { label: 'LinkedIn', sub: 'Josué Cáceres', href: 'https://linkedin.com', icon: 'linkedin' },
            { label: 'Twitter / X', sub: '@josue_dev_02', href: 'https://twitter.com', icon: 'twitter' },
          ].map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              style="
                display:flex;align-items:center;gap:0.875rem;
                background:var(--bg-surface);
                border:1px solid rgba(168,85,247,0.12);
                border-radius:8px;padding:0.875rem 1.25rem;
                text-decoration:none;
                transition:all 0.3s ease;
              "
              class="social-card"
            >
              <div style="color:var(--neon-purple);">
                {s.icon === 'github' && <GitHub size={20} />}
                {s.icon === 'linkedin' && <LinkedIn size={20} />}
                {s.icon === 'twitter' && <Twitter size={20} />}
              </div>
              <div>
                <div style="color:var(--text-primary);font-size:0.875rem;font-weight:500;">{s.label}</div>
                <div style="color:var(--text-muted);font-size:0.75rem;font-family:var(--font-mono);">{s.sub}</div>
              </div>
              <ArrowRight size={15} class="arrow-icon" />
            </a>
          ))}
        </div>

        <div style="
          padding:1rem 1.25rem;
          background:rgba(34,197,94,0.06);
          border:1px solid rgba(34,197,94,0.2);
          border-radius:8px;
          display:flex;gap:0.75rem;align-items:center;
        ">
          <div style="width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px #22c55e;flex-shrink:0;animation:glow-pulse 2s infinite;"></div>
          <p style="font-size:0.82rem;color:var(--text-secondary);line-height:1.5;">
            <span style="color:#22c55e;font-weight:600;">Available</span> — Average response time: 24h
          </p>
        </div>
      </div>

      <div class="reveal-right">
        <form
          id="contact-form"
          action="https://formspree.io/f/your_form_id"
          method="POST"
          style="display:flex;flex-direction:column;gap:1.25rem;"
        >
          <div>
            <label style="display:block;font-family:var(--font-mono);font-size:0.72rem;color:var(--neon-purple);letter-spacing:0.1em;margin-bottom:0.5rem;">NAME</label>
            <input
              type="text"
              name="name"
              placeholder="Your full name"
              class="cyber-input"
              required
            />
          </div>

          <div>
            <label style="display:block;font-family:var(--font-mono);font-size:0.72rem;color:var(--neon-purple);letter-spacing:0.1em;margin-bottom:0.5rem;">EMAIL</label>
            <input
              type="email"
              name="email"
              placeholder="your@email.com"
              class="cyber-input"
              required
            />
          </div>

          <div>
            <label style="display:block;font-family:var(--font-mono);font-size:0.72rem;color:var(--neon-purple);letter-spacing:0.1em;margin-bottom:0.5rem;">SUBJECT</label>
            <input
              type="text"
              name="subject"
              placeholder="How can i help you?"
              class="cyber-input"
            />
          </div>

          <div>
            <label style="display:block;font-family:var(--font-mono);font-size:0.72rem;color:var(--neon-purple);letter-spacing:0.1em;margin-bottom:0.5rem;">MESSAGE</label>
            <textarea
              name="message"
              rows="5"
              placeholder="Talk about your project"
              class="cyber-input"
              style="resize:vertical;min-height:130px;"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary animate-glow-pulse" style="justify-content:center;gap:0.5rem;width:100%;">
            Send Message
            <ArrowRight size={18} />
          </button>

          <p style="font-family:var(--font-mono);font-size:0.68rem;color:var(--text-muted);text-align:center;letter-spacing:0.05em;">
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<footer style="
  background:var(--bg-surface);
  border-top:1px solid rgba(168,85,247,0.1);
  padding:2rem 0;
">
  <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
    <div style="display:flex;align-items:center;gap:0.5rem;">
      <div style="width:28px;height:28px;background:linear-gradient(135deg,#7c3aed,#a855f7);border-radius:5px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:0.7rem;font-weight:900;color:#fff;">JC</div>
      <span style="font-family:var(--font-mono);font-size:0.75rem;color:var(--text-muted);">© 2026 Josué Cáceres Iriarte — All rights reserved</span>
    </div>
    <span style="font-family:var(--font-mono);font-size:0.72rem;color:var(--text-muted);">
      Built with <span style="color:var(--neon-purple);">Astro</span> + <span style="color:var(--neon-cyan);">Tailwind</span>
    </span>
  </div>
</footer>

<style>
  .email-btn:hover {
    border-color: rgba(168,85,247,0.4) !important;
    box-shadow: 0 0 15px rgba(168,85,247,0.15);
  }
  .social-card:hover {
    border-color: rgba(168,85,247,0.3) !important;
    background: var(--bg-elevated) !important;
    box-shadow: 0 0 20px rgba(168,85,247,0.1);
  }
  .social-card .arrow-icon { margin-left: auto; color: var(--text-muted); transition: all 0.2s; }
  .social-card:hover .arrow-icon { color: var(--neon-purple); transform: translateX(3px); }
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr !important; gap: 2.5rem !important; }
  }
</style>
