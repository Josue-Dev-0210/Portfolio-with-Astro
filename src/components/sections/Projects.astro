---

import SectionTitle from '../ui/SectionTitle.astro';
import TechBadge from '../ui/TechBadge.astro';
import GitHub from '../icons/GitHub.astro';
import ExternalLink from '../icons/ExternalLink.astro';
import { projects } from '../../data/projects';

const categories = ['todos', 'frontend', 'backend', 'fullstack', 'other'] as const;
const categoryLabels: Record<string, string> = {
  todos: 'All',
  frontend: 'Frontend',
  backend: 'Backend',
  fullstack: 'Full Stack',
  other: 'Others',
};
---

<section id="projects" class="section" style="background:var(--bg-void);position:relative;overflow:hidden;">
  
  <div style="
    position:absolute;left:-150px;bottom:-150px;
    width:500px;height:500px;
    background:radial-gradient(ellipse,rgba(168,85,247,0.06) 0%,transparent 70%);
    pointer-events:none;
  "></div>

  <div class="container" style="position:relative;z-index:1;">
    <div class="reveal">
      <SectionTitle
        label="Projects"
        title='Built with <span style="color:var(--neon-purple);">code & purpose</span>'
        subtitle="Selection of projects showcasing practical solutions, technical skills, and real-world problem solving."
      />
    </div>

    <div class="reveal" style="display:flex;gap:0.5rem;flex-wrap:wrap;justify-content:center;margin-bottom:3rem;" id="filter-tabs">
      {categories.map((cat, i) => (
        <button
          class="filter-btn"
          data-filter={cat}
          style={`
            font-family:var(--font-display);
            font-size:0.72rem;
            letter-spacing:0.1em;
            text-transform:uppercase;
            padding:0.45rem 1.1rem;
            border-radius:4px;
            cursor:pointer;
            transition:all 0.25s ease;
            border:1px solid rgba(168,85,247,0.2);
            background:${i === 0 ? 'rgba(168,85,247,0.15)' : 'transparent'};
            color:${i === 0 ? 'var(--neon-purple)' : 'var(--text-muted)'};
            ${i === 0 ? 'border-color:rgba(168,85,247,0.5);' : ''}
          `}
        >
          {categoryLabels[cat]}
        </button>
      ))}
    </div>

    <div
      id="projects-grid"
      style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;"
      class="projects-grid"
    >
      {projects.map((project, i) => (
        <article
          class="project-card gradient-border"
          data-category={project.category}
          style={`
            padding:0;
            overflow:hidden;
            position:relative;
            animation-delay:${i * 0.08}s;
            cursor:${project.demo ? 'pointer' : 'default'};
          `}
          onclick={project.demo ? `window.open('${project.demo}','_blank')` :undefined};
        >
          {project.featured && (
            <div style="
              position:absolute;top:0;left:0;right:0;height:2px;
              background:linear-gradient(90deg,var(--deep-purple),var(--neon-purple),var(--neon-cyan));
              z-index:2;
            "></div>
          )}

          <div style="padding:1.75rem;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;">
              <!-- Category tag -->
              <span style="
                font-family:var(--font-mono);font-size:0.65rem;
                letter-spacing:0.12em;text-transform:uppercase;
                color:var(--neon-purple);
                background:rgba(168,85,247,0.08);
                padding:0.2rem 0.6rem;border-radius:3px;
                border:1px solid rgba(168,85,247,0.15);
              ">
                {categoryLabels[project.category]}
              </span>

              <!-- Links -->
              <div style="display:flex;gap:0.75rem;">
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener"
                    aria-label="Ver en GitHub"
                    style="color:var(--text-muted);transition:color 0.2s;display:flex;"
                    class="icon-link"
                  >
                    <GitHub size={17} />
                  </a>
                )}
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener"
                    aria-label="Ver demo"
                    style="color:var(--text-muted);transition:color 0.2s;display:flex;"
                    class="icon-link"
                  >
                    <ExternalLink size={17} />
                  </a>
                )}
              </div>
            </div>

            <h3 style="
              font-family:var(--font-display);
              font-size:1.05rem;font-weight:700;
              color:var(--text-primary);
              letter-spacing:0.02em;
              margin-bottom:0.6rem;
            ">
              {project.title}
              {project.featured && (
                <span style="
                  margin-left:0.5rem;
                  font-size:0.6rem;letter-spacing:0.15em;
                  color:var(--neon-cyan);
                  font-weight:500;vertical-align:middle;
                ">★ DESTACADO</span>
              )}
            </h3>

            <p style="
              color:var(--text-secondary);
              font-size:0.875rem;
              line-height:1.65;
              margin-bottom:1.25rem;
              min-height:4.5rem;
            ">
              {project.description}
            </p>

            <div style="height:1px;background:rgba(168,85,247,0.1);margin-bottom:1.25rem;"></div>

            <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
              {project.tags.map((tag) => <TechBadge name={tag} />)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .icon-link:hover { color: var(--neon-purple) !important; }
  .filter-btn:hover:not(.active) {
    border-color: rgba(168,85,247,0.35) !important;
    color: var(--text-primary) !important;
    background: rgba(168,85,247,0.06) !important;
  }
  .filter-btn.active {
    background: rgba(168,85,247,0.15) !important;
    color: var(--neon-purple) !important;
    border-color: rgba(168,85,247,0.5) !important;
  }
  @media (max-width: 1024px) {
    .projects-grid { grid-template-columns: repeat(2,1fr) !important; }
  }
  @media (max-width: 640px) {
    .projects-grid { grid-template-columns: 1fr !important; }
  }

  .project-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(168,85,247,0.15);
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const show = filter === 'todos' || cat === filter;
        (card as HTMLElement).style.display = show ? 'block' : 'none';
        if (show) {
          (card as HTMLElement).style.animation = 'scale-in 0.3s ease forwards';
        }
      });
    });
  });
</script>
