---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowRight from '../components/icons/ArrowRight.astro';
---

<BaseLayout title="404 — Archivo no encontrado" description="La ruta solicitada no existe en el sistema.">
  <main style="height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-void);position:relative;overflow:hidden;">
    <div class="grid-bg" style="position:absolute;inset:0;opacity:0.3;pointer-events:none;"></div>
    
    <div style="text-align:center;position:relative;z-index:1;" class="container">
      <div style="font-family:var(--font-mono);color:var(--neon-purple);font-size:1.2rem;margin-bottom:1rem;letter-spacing:0.1em;">
        // ERROR DE SISTEMA
      </div>
      
      <div class="glitch-text" data-text="404" style="display:inline-block;margin-bottom:1rem;">
        <h1 style="font-family:var(--font-display);font-size:clamp(6rem, 15vw, 10rem);font-weight:900;line-height:1;color:var(--text-primary);letter-spacing:-0.05em;">
          404
        </h1>
      </div>
      
      <p style="color:var(--text-secondary);font-size:1.1rem;max-width:400px;margin:0 auto 2.5rem;line-height:1.6;">
        La ruta que intentas acceder ha sido borrada del servidor o nunca existió.
      </p>
      
      <a href="/" class="btn btn-primary animate-glow-pulse" style="justify-content:center;gap:0.75rem;">
        Volver al Inicio
        <ArrowRight size={18} />
      </a>
    </div>
  </main>
</BaseLayout>
